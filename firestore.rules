rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMasterAdmin() {
      return request.auth != null && request.auth.token.email == 'hectorg@accountability-app.com';
    }

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // True when the signed-in user and the target user share a non-null companyId.
    // Enables cross-user writes for peer assessments, SMART goal approvals, and
    // cross-user point awards — but only between teammates in the same company.
    function sameCompany(userId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId ==
          get(/databases/$(database)/documents/users/$(userId)).data.companyId;
    }

    // True when the requester has a non-null teamId — used to scope
    // quoteComments reads/writes to teammates only (narrower than sameCompany).
    function myTeamId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamId;
    }

    // App config — readable by all authenticated users
    match /appConfig/{docId} {
      allow read: if request.auth != null;
      allow write: if isMasterAdmin();
    }

    // Companies — readable by all authenticated users, writable by master admin only
    match /companies/{companyId} {
      allow read: if request.auth != null;
      allow write: if isMasterAdmin();
    }

    // Teams (sub-groups within a company) — readable by all authenticated
    // users, writable by master admin only, same pattern as companies.
    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow write: if isMasterAdmin();
    }

    // Users — own doc + admin access
    match /users/{userId} {
      allow get: if request.auth != null && (request.auth.uid == userId || isMasterAdmin() || isAdmin() || sameCompany(userId));
      allow list: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || isMasterAdmin() || isAdmin() || sameCompany(userId));
    }

    match /toolSessions/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid) &&
        (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /smartGoals/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid) &&
        (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /problemSolving/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid) &&
        (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /feedback/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid) &&
        (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /visions/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid) &&
        (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /discAssessments/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid) &&
        (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /visualBoard/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid) &&
        (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /scoreHistory/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid) &&
        (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /pointsLog/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid) &&
        (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /coachingSessions/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid) &&
        (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /kaizenLog/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid) &&
        (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /eqOpex/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid) &&
        (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /eqAssessments/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid) &&
        (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /careerGoals/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid) &&
        (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /surveys360/{docId} {
      // Any authenticated user can read (anonymous auth used for survey respondents)
      allow read: if request.auth != null;
      // Only the survey owner can create
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      // Any authenticated user can update (to append responses from anonymous respondents)
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Leadership Quotes comments — team-scoped (not company-wide): only
    // members sharing a teamId can read/post each other's comments.
    match /quoteComments/{docId} {
      allow read: if request.auth != null && myTeamId() != null && resource.data.teamId == myTeamId();
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid &&
        myTeamId() != null && request.resource.data.teamId == myTeamId();
      allow update: if false;
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isMasterAdmin());
    }
  }
}

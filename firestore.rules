rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMasterAdmin() {
      return request.auth != null && request.auth.token.email == 'hectorg@accountability-app.com';
    }

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // True when the signed-in user and the target user share a non-null companyId.
    // Enables cross-user writes for peer assessments, SMART goal approvals, and
    // cross-user point awards — but only between teammates in the same company.
    function sameCompany(userId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId ==
          get(/databases/$(database)/documents/users/$(userId)).data.companyId;
    }

    // True when the requester has a non-null teamId — used to scope
    // podcastComments reads/writes to teammates only (narrower than sameCompany).
    function myTeamId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamId;
    }

    // True when the requester's own companyId matches the given companyId —
    // used to scope quoteComments reads/writes to every member of the same
    // company (the whole "team" as the Team page defines it), not a narrower
    // teamId sub-group.
    function myCompanyIdIs(companyId) {
      return request.auth != null && companyId != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;
    }

    // App config — readable by all authenticated users
    match /appConfig/{docId} {
      allow read: if request.auth != null;
      allow write: if isMasterAdmin();
    }

    // Companies — readable by all authenticated users, writable by master admin only
    match /companies/{companyId} {
      allow read: if request.auth != null;
      allow write: if isMasterAdmin();
    }

    // Teams (sub-groups within a company) — readable by all authenticated
    // users, writable by master admin only, same pattern as companies.
    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow write: if isMasterAdmin();
    }

    // Users — own doc + admin access
    match /users/{userId} {
      allow get: if request.auth != null && (request.auth.uid == userId || isMasterAdmin() || isAdmin() || sameCompany(userId));
      allow list: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || isMasterAdmin() || isAdmin() || sameCompany(userId));
    }

    match /toolSessions/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid) &&
        (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /smartGoals/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid) &&
        (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /problemSolving/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid) &&
        (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /feedback/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid) &&
        (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /visions/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid) &&
        (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /discAssessments/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid) &&
        (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /visualBoard/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid) &&
        (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /scoreHistory/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid) &&
        (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /pointsLog/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid) &&
        (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /coachingSessions/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid) &&
        (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /kaizenLog/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid) &&
        (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /eqOpex/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid) &&
        (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /eqAssessments/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid) &&
        (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /careerGoals/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid) &&
        (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /surveys360/{docId} {
      // Any authenticated user can read (anonymous auth used for survey respondents)
      allow read: if request.auth != null;
      // Only the survey owner can create
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      // Any authenticated user can update (to append responses from anonymous respondents)
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Leadership Quotes comments — company-wide: every member of the same
    // company can read/post each other's comments, not just a narrower teamId
    // sub-group (so nobody is isolated just for lacking a specific team assignment).
    match /quoteComments/{docId} {
      allow read: if myCompanyIdIs(resource.data.companyId);
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid &&
        myCompanyIdIs(request.resource.data.companyId);
      allow update: if false;
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isMasterAdmin());
    }

    // Invites — created only by the sendInvite Cloud Function (admin SDK, bypasses
    // rules), so clients never write these directly. The inviter can read/list the
    // invites they sent; the invited person can read/accept their own invite once
    // they've signed up (their auth email must match the invite's email).
    match /invites/{inviteId} {
      allow read: if request.auth != null &&
        (resource.data.invitedByUid == request.auth.uid || resource.data.email == request.auth.token.email || isMasterAdmin());
      allow create: if false;
      allow update: if request.auth != null && resource.data.email == request.auth.token.email;
      allow delete: if request.auth != null && (resource.data.invitedByUid == request.auth.uid || isMasterAdmin());
    }

    // Podcast comments — same team-scoped pattern as quoteComments.
    match /podcastComments/{docId} {
      allow read: if request.auth != null && myTeamId() != null && resource.data.teamId == myTeamId();
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid &&
        myTeamId() != null && request.resource.data.teamId == myTeamId();
      allow update: if false;
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isMasterAdmin());
    }
  }
}

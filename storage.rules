rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Any signed-in user can read and write their own avatar
    match /avatars/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Tool "how to use" walkthrough videos — readable by any signed-in user,
    // uploadable only by the master admin.
    match /toolVideos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == 'hectorg@accountability-app.com'
                   && request.resource.size < 200 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
    }

    // Waste Walk observation photos — each user reads and writes only their own,
    // under wasteWalk/{their uid}/. Readable by any signed-in user so leaders can
    // review them.
    match /wasteWalk/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // SMART goal completion proof (photo, screenshot, or document) attached
    // when requesting leader approval — readable by any signed-in user so the
    // approving leader can open it, writable only by the goal's own owner.
    // No contentType restriction since images, PDFs, and office docs are all
    // allowed here (unlike the image-only rules above).
    match /smartGoalProofs/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
